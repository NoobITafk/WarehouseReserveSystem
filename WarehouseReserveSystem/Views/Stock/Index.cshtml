@model IReadOnlyList<WarehouseReserveSystem.Models.StockItem>
@{
    ViewData["Title"] = "Оборотно-сальдова відомість залишків";
    Layout = "_Layout";
    var warehouses = ViewBag.Warehouses as IReadOnlyList<WarehouseReserveSystem.Models.Warehouse> ?? [];
    var categories = ViewBag.Categories as IReadOnlyList<WarehouseReserveSystem.Models.Category> ?? [];
    int? selectedWh = ViewBag.SelectedWarehouseId;
    int? selectedCat = ViewBag.SelectedCategoryId;
    string? search = ViewBag.SearchTerm;
    int totalUnits = ViewBag.TotalUnits ?? 0;
    decimal totalValuation = ViewBag.TotalValuation ?? 0m;
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <h1 style="font-size: 1.6rem; font-weight: 700; color: var(--text-main); margin: 0 0 0.25rem 0;">Залишки матеріальних цінностей</h1>
        <p style="color: var(--text-secondary); margin: 0; font-size: 0.85rem;">Оборотно-сальдова відомість у розрізі адресних комірок та серійних партій</p>
    </div>

    <div class="btn-group-responsive">
        <a asp-controller="Reports" asp-action="ExportStockBalancesCsv" class="btn-wms-outline">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Експорт у CSV (Excel)
        </a>
        @if (User.IsInRole("Admin") || User.IsInRole("Storekeeper"))
        {
            <a asp-controller="Movements" asp-action="Transfer" class="btn-wms-primary">
                Перемістити між комірками
            </a>
        }
    </div>
</div>

<!-- Filter Bar -->
<div class="wms-card" style="padding: 1rem; margin-bottom: 1.5rem;">
    <form method="get" asp-action="Index" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 220px;">
            <input type="text" name="search" value="@search" placeholder="Пошук за товаром, SKU або коміркою (напр. A-01)..." class="wms-input" />
        </div>

        <div style="width: 240px;">
            <select name="warehouseId" class="wms-input">
                <option value="">Всі складські комплекси</option>
                @foreach (var wh in warehouses)
                {
                    <option value="@wh.Id" selected="@(wh.Id == selectedWh)">@wh.Name</option>
                }
            </select>
        </div>

        <div style="width: 240px;">
            <select name="categoryId" class="wms-input">
                <option value="">Всі категорії</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.Id" selected="@(cat.Id == selectedCat)">@cat.Name</option>
                }
            </select>
        </div>

        <button type="submit" class="btn-wms-outline">Фільтрувати</button>

        @if (selectedWh.HasValue || selectedCat.HasValue || !string.IsNullOrWhiteSpace(search))
        {
            <a asp-action="Index" class="btn-wms-outline" style="color: #f87171; border-color: rgba(239, 68, 68, 0.3);">Скинути</a>
        }
    </form>
</div>

<!-- Totals Strip -->
<div style="display: flex; gap: 2rem; margin-bottom: 1.25rem; font-size: 0.9rem; background: var(--bg-card-subtle); padding: 0.75rem 1.25rem; border-radius: 8px; border: 1px solid var(--border-color); flex-wrap: wrap;">
    <div>Знайдено записів: <strong style="color: var(--text-main);">@Model.Count</strong></div>
    <div>Всього одиниць: <strong style="color: #34d399;">@totalUnits.ToString("N0") од.</strong></div>
    <div>Балансова вартість: <strong style="color: #60a5fa;">@totalValuation.ToString("N2") грн</strong></div>
</div>

<!-- Stock Table -->
<div class="wms-card" style="padding: 0; overflow: hidden;">
    <div class="table-responsive">
        <table class="wms-table">
            <thead>
                <tr>
                    <th>Адресна комірка</th>
                    <th>Склад / Зона</th>
                    <th>Артикул (SKU)</th>
                    <th>Найменування товару</th>
                    <th>Партія</th>
                    <th>Кількість</th>
                    <th>Собівартість</th>
                    <th>Сума залишку</th>
                    <th>Оновлено</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="9" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                            Залишків за обраними параметрами фільтру не знайдено.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    var p = item.Product;
                    var loc = item.StorageLocation;
                    var zone = loc?.StorageZone;
                    var wh = zone?.Warehouse;
                    var totalLineCost = item.Quantity * (p?.CostPrice ?? 0m);

                    <tr>
                        <td>
                            <span class="sku-badge" style="font-weight: 700; color: var(--text-main); background: rgba(59, 130, 246, 0.15); border-color: rgba(59, 130, 246, 0.3);">
                                @(loc?.Code ?? "-")
                            </span>
                        </td>
                        <td style="font-size: 0.8rem;">
                            <div style="color: var(--text-main); font-weight: 500;">@(wh?.Code ?? "-")</div>
                            <div style="color: var(--text-muted);">@(zone?.Name ?? "-")</div>
                        </td>
                        <td>
                            <span class="sku-badge">@(p?.Sku ?? "-")</span>
                        </td>
                        <td>
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@p?.Id" style="color: var(--text-main); font-weight: 600; text-decoration: none; font-size: 0.9rem;">
                                @(p?.Name ?? "-")
                            </a>
                            <div style="font-size: 0.75rem; color: var(--text-muted);">Категорія: @(p?.Category?.Name ?? "-")</div>
                        </td>
                        <td style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: var(--text-secondary);">
                            @(item.BatchNumber ?? "Стандарт")
                        </td>
                        <td style="font-weight: 700; color: #34d399; font-size: 0.95rem;">
                            @item.Quantity @(p?.Unit ?? "шт")
                        </td>
                        <td style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: var(--text-secondary);">
                            @((p?.CostPrice ?? 0m).ToString("N2")) ₴
                        </td>
                        <td style="font-family: 'JetBrains Mono', monospace; font-size: 0.9rem; font-weight: 600; color: #60a5fa;">
                            @totalLineCost.ToString("N2") ₴
                        </td>
                        <td style="font-size: 0.75rem; color: var(--text-muted);">
                            @item.LastUpdatedAt.ToString("dd.MM.yyyy HH:mm")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
