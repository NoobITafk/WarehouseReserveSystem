@model WarehouseReserveSystem.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Авторизація WMS";
    Layout = "_Layout";
}

<div style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 2.5rem 1rem;">
    <div style="max-width: 440px; width: 100%;">
        <!-- Brand Header -->
        <div style="text-align: center; margin-bottom: 2rem;">
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 58px; height: 58px; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border-radius: 16px; color: #ffffff; margin-bottom: 1.25rem; box-shadow: 0 12px 28px rgba(15, 23, 42, 0.18); border: 1px solid rgba(255,255,255,0.1);">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                    <line x1="12" y1="22.08" x2="12" y2="12"/>
                </svg>
            </div>
            <h1 style="font-size: 1.75rem; font-weight: 800; color: #0f172a; margin: 0 0 0.4rem 0; letter-spacing: -0.025em;">WarehouseReserve WMS</h1>
            <p style="color: var(--text-secondary); font-size: 0.92rem; margin: 0;">Корпоративна платформа логістики та адресного обліку</p>
        </div>

        <div class="wms-card" style="padding: 2.25rem 2rem; box-shadow: 0 20px 45px rgba(15, 23, 42, 0.08); border: 1px solid #e2e8f0; border-radius: 18px;">
            <form id="mainLoginForm" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" style="background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 0.75rem 1rem; border-radius: 10px; font-size: 0.85rem; margin-bottom: 1.25rem;"></div>

                <div style="margin-bottom: 1.25rem;">
                    <label asp-for="Login" class="wms-label" style="font-weight: 600; font-size: 0.875rem; color: #334155; margin-bottom: 0.4rem; display: block;">Логін або робочий Email</label>
                    <input asp-for="Login" id="loginInput" class="wms-input" placeholder="admin / storekeeper" autofocus autocomplete="username" style="width: 100%; border-radius: 10px; padding: 0.75rem 1rem; border: 1.5px solid #cbd5e1; font-size: 0.95rem;" />
                    <span asp-validation-for="Login" style="color: #dc2626; font-size: 0.8rem; margin-top: 0.25rem; display: block;"></span>
                </div>

                <div style="margin-bottom: 1.25rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                        <label asp-for="Password" class="wms-label" style="font-weight: 600; font-size: 0.875rem; color: #334155; margin-bottom: 0;">Пароль доступу</label>
                    </div>
                    <div style="position: relative;">
                        <input asp-for="Password" id="passwordInput" type="password" class="wms-input" style="width: 100%; border-radius: 10px; padding: 0.75rem 2.75rem 0.75rem 1rem; border: 1.5px solid #cbd5e1; font-size: 0.95rem;" placeholder="••••••••" autocomplete="current-password" />
                        <button type="button" onclick="togglePasswordVisibility()" style="position: absolute; right: 0.85rem; top: 50%; transform: translateY(-50%); background: transparent; border: none; color: #64748b; cursor: pointer; display: flex; align-items: center; padding: 0.25rem;" title="Показати/приховати введений пароль">
                            <svg id="eyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" style="color: #dc2626; font-size: 0.8rem; margin-top: 0.25rem; display: block;"></span>
                </div>

                <div style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
                    <input asp-for="RememberMe" type="checkbox" id="rememberMe" style="accent-color: #0f172a; width: 16px; height: 16px; cursor: pointer;" />
                    <label for="rememberMe" style="font-size: 0.85rem; color: #64748b; cursor: pointer; user-select: none;">Запам'ятати мене на цьому робочому місці</label>
                </div>

                <button type="submit" class="btn-wms-primary" style="width: 100%; justify-content: center; padding: 0.85rem; font-size: 1rem; font-weight: 700; background: #0f172a; color: #ffffff; border-radius: 12px; border: none; cursor: pointer; display: flex; align-items: center; gap: 0.6rem; transition: background 0.2s ease;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                        <polyline points="10 17 15 12 10 7"/>
                        <line x1="15" y1="12" x2="3" y2="12"/>
                    </svg>
                    <span>Увійти в систему</span>
                </button>
            </form>

            <div style="margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid #f1f5f9; display: flex; align-items: center; justify-content: center; gap: 0.5rem; color: #94a3b8; font-size: 0.78rem;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <span>Захищене з'єднання • Рольовий аудит RBAC</span>
            </div>
        </div>
    </div>
</div>

<script>
function togglePasswordVisibility() {
    const input = document.getElementById('passwordInput');
    const icon = document.getElementById('eyeIcon');
    if (input.type === 'password') {
        input.type = 'text';
        icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';
    } else {
        input.type = 'password';
        icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
    }
}
</script>
