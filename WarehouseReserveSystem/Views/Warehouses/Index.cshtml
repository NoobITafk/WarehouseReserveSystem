@model IReadOnlyList<WarehouseReserveSystem.Models.Warehouse>
@{
    ViewData["Title"] = "Складські комплекси";
    Layout = "_Layout";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <h1 style="font-size: 1.6rem; font-weight: 700; color: #fff; margin: 0 0 0.25rem 0;">Мережа складських комплексів</h1>
        <p style="color: var(--text-secondary); margin: 0; font-size: 0.85rem;">Логістичні хаби, топологія адресного зберігання та фізичні параметри об'єктів</p>
    </div>
</div>

<div class="cards-grid-auto">
    @foreach (var wh in Model)
    {
        var totalLocs = wh.Zones.SelectMany(z => z.Locations).Count();

        <div class="wms-card wms-card-hover" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
                    <div>
                        <span class="sku-badge" style="background: rgba(59, 130, 246, 0.15); color: #93c5fd; border-color: rgba(59, 130, 246, 0.3);">
                            @wh.Code
                        </span>
                        <h3 style="margin: 0.5rem 0 0.25rem 0; font-size: 1.2rem; font-weight: 700; color: #fff;">@wh.Name</h3>
                    </div>
                    <span class="badge-custom badge-emerald">Активний</span>
                </div>

                <div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1.25rem;">
                    <div style="display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.35rem;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        <span>@wh.Address</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(wh.ContactPhone))
                    {
                        <div style="display: flex; align-items: center; gap: 0.4rem;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                            <span style="color: #60a5fa;">@wh.ContactPhone</span>
                        </div>
                    }
                </div>

                <!-- Metrics breakdown -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; background: var(--bg-card-subtle); padding: 0.85rem; border-radius: 8px; margin-bottom: 1.25rem;">
                    <div>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">Корисна площа:</div>
                        <div style="font-size: 1rem; font-weight: 700; color: #fff;">@wh.TotalAreaSqM.ToString("N0") м²</div>
                    </div>
                    <div>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">Зон зберігання:</div>
                        <div style="font-size: 1rem; font-weight: 700; color: #60a5fa;">@wh.Zones.Count зон</div>
                    </div>
                    <div>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">Адресних комірок:</div>
                        <div style="font-size: 1rem; font-weight: 700; color: #34d399;">@totalLocs осередків</div>
                    </div>
                    <div>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">Тип комплексу:</div>
                        <div style="font-size: 0.9rem; font-weight: 600; color: #fff;">Клас A+ / Склад</div>
                    </div>
                </div>
            </div>

            <div>
                <a asp-action="Details" asp-route-id="@wh.Id" class="btn-wms-primary" style="width: 100%; justify-content: center;">
                    Переглянути топологію зон та комірок →
                </a>
            </div>
        </div>
    }
</div>
