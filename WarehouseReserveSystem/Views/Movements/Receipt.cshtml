@model WarehouseReserveSystem.ViewModels.ReceiptFormViewModel
@{
    ViewData["Title"] = "Оприбуткування від постачальника";
    Layout = "_Layout";
}

<div style="max-width: 760px; margin: 0 auto;">
    <div style="margin-bottom: 1.5rem;">
        <a asp-action="Index" style="color: var(--text-muted); text-decoration: none; font-size: 0.85rem;">← До журналу накладних</a>
        <h1 style="font-size: 1.6rem; font-weight: 700; color: #fff; margin: 0.5rem 0 0.25rem 0;">Оприбуткування матеріальних цінностей</h1>
        <p style="color: var(--text-secondary); margin: 0; font-size: 0.85rem;">Формування прибуткової накладної та зарахування на адресну комірку зберігання</p>
    </div>

    <div class="wms-card">
        <form asp-action="Receipt" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #fca5a5; padding: 0.75rem; border-radius: 8px; margin-bottom: 1.25rem;"></div>

            <div style="margin-bottom: 1.25rem;">
                <label asp-for="SupplierId" class="wms-label">Постачальник *</label>
                <select asp-for="SupplierId" asp-items="Model.Suppliers" class="wms-input"></select>
                <span asp-validation-for="SupplierId" style="color: #f87171; font-size: 0.8rem;"></span>
            </div>

            <div class="form-grid-2">
                <div>
                    <label asp-for="ProductId" class="wms-label">Товар для оприбуткування *</label>
                    <select asp-for="ProductId" asp-items="Model.Products" class="wms-input"></select>
                    <span asp-validation-for="ProductId" style="color: #f87171; font-size: 0.8rem;"></span>
                </div>
                <div>
                    <label asp-for="DestinationLocationId" class="wms-label">Адресна комірка розміщення *</label>
                    <select asp-for="DestinationLocationId" asp-items="Model.Locations" class="wms-input"></select>
                    <span asp-validation-for="DestinationLocationId" style="color: #f87171; font-size: 0.8rem;"></span>
                </div>
            </div>

            <div class="form-grid-3">
                <div>
                    <label asp-for="Quantity" class="wms-label">Кількість *</label>
                    <input asp-for="Quantity" type="number" min="1" class="wms-input" />
                    <span asp-validation-for="Quantity" style="color: #f87171; font-size: 0.8rem;"></span>
                </div>
                <div>
                    <label asp-for="UnitPrice" class="wms-label">Ціна закупівлі, грн *</label>
                    <input asp-for="UnitPrice" type="number" step="0.01" class="wms-input" />
                    <span asp-validation-for="UnitPrice" style="color: #f87171; font-size: 0.8rem;"></span>
                </div>
                <div>
                    <label asp-for="BatchNumber" class="wms-label">Партія / Серія</label>
                    <input asp-for="BatchNumber" class="wms-input" placeholder="B-2026-..." />
                </div>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label asp-for="Notes" class="wms-label">Примітки / Номер ТТН перевізника</label>
                <input asp-for="Notes" class="wms-input" placeholder="Накладна №..., доставлено Новою Поштою" />
            </div>

            <div class="form-actions-responsive">
                <a asp-action="Index" class="btn-wms-outline">Скасувати</a>
                <button type="submit" class="btn-wms-emerald">Провести прибуткову накладну</button>
            </div>
        </form>
    </div>
</div>
