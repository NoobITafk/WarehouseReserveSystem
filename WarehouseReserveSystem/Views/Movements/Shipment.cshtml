@model WarehouseReserveSystem.ViewModels.ShipmentFormViewModel
@{
    ViewData["Title"] = "Відвантаження клієнту";
    Layout = "_Layout";
}

<div style="max-width: 760px; margin: 0 auto;">
    <div style="margin-bottom: 1.5rem;">
        <a asp-action="Index" style="color: var(--text-muted); text-decoration: none; font-size: 0.85rem;">← До журналу накладних</a>
        <h1 style="font-size: 1.6rem; font-weight: 700; color: #fff; margin: 0.5rem 0 0.25rem 0;">Оформлення видаткової накладної</h1>
        <p style="color: var(--text-secondary); margin: 0; font-size: 0.85rem;">Списання матеріальних цінностей зі складу на клієнта з контролем наявності</p>
    </div>

    <div class="wms-card">
        <form asp-action="Shipment" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #fca5a5; padding: 0.75rem; border-radius: 8px; margin-bottom: 1.25rem;"></div>

            <div style="margin-bottom: 1.25rem;">
                <label asp-for="CustomerName" class="wms-label">Замовник / Контрагент-одержувач *</label>
                <input asp-for="CustomerName" class="wms-input" placeholder="ТОВ «Назва Компанії» або ПІБ клієнта" />
                <span asp-validation-for="CustomerName" style="color: #f87171; font-size: 0.8rem;"></span>
            </div>

            <div class="form-grid-2">
                <div>
                    <label asp-for="ProductId" class="wms-label">Товар для відвантаження *</label>
                    <select asp-for="ProductId" asp-items="Model.Products" class="wms-input"></select>
                    <span asp-validation-for="ProductId" style="color: #f87171; font-size: 0.8rem;"></span>
                </div>
                <div>
                    <label asp-for="SourceLocationId" class="wms-label">Вихідна комірка списання *</label>
                    <select asp-for="SourceLocationId" asp-items="Model.Locations" class="wms-input"></select>
                    <span asp-validation-for="SourceLocationId" style="color: #f87171; font-size: 0.8rem;"></span>
                </div>
            </div>

            <div class="form-grid-2">
                <div>
                    <label asp-for="Quantity" class="wms-label">Кількість для відвантаження *</label>
                    <input asp-for="Quantity" type="number" min="1" class="wms-input" />
                    <span asp-validation-for="Quantity" style="color: #f87171; font-size: 0.8rem;"></span>
                </div>
                <div>
                    <label asp-for="UnitPrice" class="wms-label">Ціна реалізації, грн *</label>
                    <input asp-for="UnitPrice" type="number" step="0.01" class="wms-input" />
                    <span asp-validation-for="UnitPrice" style="color: #f87171; font-size: 0.8rem;"></span>
                </div>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label asp-for="Notes" class="wms-label">Підстава / Номер рахунку або замовлення</label>
                <input asp-for="Notes" class="wms-input" placeholder="Замовлення клієнта №..." />
            </div>

            <div class="form-actions-responsive">
                <a asp-action="Index" class="btn-wms-outline">Скасувати</a>
                <button type="submit" class="btn-wms-primary">Провести видаткову накладну</button>
            </div>
        </form>
    </div>
</div>
